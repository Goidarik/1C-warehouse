Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

    Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда

        // Переносим шапку
        СкладОтправитель = ДанныеЗаполнения.СкладОтправитель;
        СкладПолучатель  = ДанныеЗаполнения.СкладПолучатель;

        // Переносим табличную часть
        Товары.Очистить();
        Для каждого Стр Из ДанныеЗаполнения.Товары Цикл
            Нов = Товары.Добавить();
            Нов.Товар = Стр.Товар;
            Нов.Количество = Стр.Количество;
        КонецЦикла;

    КонецЕсли;

КонецПроцедуры


Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Если Не ЗначениеЗаполнено(СкладОтправитель) Или Не ЗначениеЗаполнено(СкладПолучатель) Тогда
		Сообщить("Не заполнены склады отправитель/получатель.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если СкладОтправитель = СкладПолучатель Тогда
		Сообщить("Склады отправитель и получатель не должны совпадать.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Движения.ОстаткиТоваровНаСкладах.Очистить();
	Движения.ОстаткиТоваровНаСкладах.Записывать = Истина;

	МассивТоваров = Новый Массив;

	Для Каждого СтрокаТовары Из Товары Цикл

		Если Не ЗначениеЗаполнено(СтрокаТовары.Товар) Тогда
			Сообщить("Не заполнен товар в табличной части.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		Если СтрокаТовары.Количество <= 0 Тогда
			Сообщить("Количество должно быть больше 0.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		МассивТоваров.Добавить(СтрокаТовары.Товар);

		// Расход со склада-отправителя
		Движение = Движения.ОстаткиТоваровНаСкладах.Добавить();
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Склад = СкладОтправитель;
		Движение.Товар = СтрокаТовары.Товар;
		Движение.Количество = СтрокаТовары.Количество;

		// Приход на склад-получатель
		Движение = Движения.ОстаткиТоваровНаСкладах.Добавить();
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Склад = СкладПолучатель;
		Движение.Товар = СтрокаТовары.Товар;
		Движение.Количество = СтрокаТовары.Количество;

	КонецЦикла;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// При отрицательных остатках на складе
	Попытка
    	Движения.Записать();
	Исключение
    	ТекстОшибки = ОписаниеОшибки();

    	Сообщ = Новый СообщениеПользователю;
    	Сообщ.Текст =
        	"Недостаточно товара на складе (или движение не может быть записано). Проведение отменено."
        	+ Символы.ПС + Символы.ПС
        	+ "Технические подробности:" + Символы.ПС + ТекстОшибки;
    	Сообщ.Сообщить();

    	Отказ = Истина;
    	Возврат;
	КонецПопытки;

	// Контроль отрицательных остатков — проверяем склад-отправитель
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Товар,
	|	Остатки.Склад,
	|	Остатки.КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровНаСкладах.Остатки(&Момент) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0
	|	И Остатки.Склад = &Склад
	|	И Остатки.Товар В (&МассивТоваров)";
	
	Запрос.УстановитьПараметр("Момент", Новый Граница(Дата, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Склад", СкладОтправитель);
	Запрос.УстановитьПараметр("МассивТоваров", МассивТоваров);

	Если Запрос.Выполнить().Выбрать().Следующий() Тогда
		Сообщить("Недостаточно товара на складе отправителе. Проведение отменено.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

КонецПроцедуры
