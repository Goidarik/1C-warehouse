Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
    	Сообщить("Не заполнен склад.");
    	Отказ = Истина;
    	Возврат;
	КонецЕсли;

	МассивКомплектующих = Новый Массив;

	Для каждого Стр Из Комплектующие Цикл
    	Если Не ЗначениеЗаполнено(Стр.Товар) Тогда
        	Сообщить("Не заполнен товар в табличной части Комплектующие.");
        	Отказ = Истина;
        	Продолжить;
    	КонецЕсли;
    	Если Стр.Количество <= 0 Тогда
        	Сообщить("Количество в Комплектующие должно быть больше 0.");
        	Отказ = Истина;
        	Продолжить;
    	КонецЕсли;
    	МассивКомплектующих.Добавить(Стр.Товар);
	КонецЦикла;

	Для каждого Стр Из Результат Цикл
    	Если Не ЗначениеЗаполнено(Стр.Товар) Тогда
        	Сообщить("Не заполнен товар в табличной части Результат.");
        	Отказ = Истина;
        	Продолжить;
    	КонецЕсли;
    	Если Стр.Количество <= 0 Тогда
        	Сообщить("Количество в Результат должно быть больше 0.");
        	Отказ = Истина;
        	Продолжить;
    	КонецЕсли;
	КонецЦикла;

	Если Отказ Тогда
    	Возврат;
	КонецЕсли;

    Движения.ОстаткиТоваровНаСкладах.Очистить();
    Движения.ОстаткиТоваровНаСкладах.Записывать = Истина;

    // Расход комплектующих
    Для каждого Стр Из Комплектующие Цикл
        Движение = Движения.ОстаткиТоваровНаСкладах.Добавить();
        Движение.Период = Дата;
        Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
        Движение.Склад = Склад;
        Движение.Товар = Стр.Товар;
        Движение.Количество = Стр.Количество;
    КонецЦикла;

    // Приход результата
    Для каждого Стр Из Результат Цикл
        Движение = Движения.ОстаткиТоваровНаСкладах.Добавить();
        Движение.Период = Дата;
        Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
        Движение.Склад = Склад;
        Движение.Товар = Стр.Товар;
        Движение.Количество = Стр.Количество;
    КонецЦикла;
	
	// При отрицательных остатках на складе
	Попытка
    	Движения.Записать();
	Исключение
    	ТекстОшибки = ОписаниеОшибки();

    	Сообщ = Новый СообщениеПользователю;
    	Сообщ.Текст =
        	"Недостаточно товара на складе (или движение не может быть записано). Проведение отменено."
        	+ Символы.ПС + Символы.ПС
        	+ "Технические подробности:" + Символы.ПС + ТекстОшибки;
    	Сообщ.Сообщить();

    	Отказ = Истина;
    	Возврат;
	КонецПопытки;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|   Остатки.Товар,
	|   Остатки.Склад,
	|   Остатки.КоличествоОстаток
	|ИЗ
	|   РегистрНакопления.ОстаткиТоваровНаСкладах.Остатки(&Момент) КАК Остатки
	|ГДЕ
	|   Остатки.КоличествоОстаток < 0
	|   И Остатки.Склад = &Склад
	|   И Остатки.Товар В (&МассивТоваров)";

	Запрос.УстановитьПараметр("Момент", Новый Граница(Дата, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("МассивТоваров", МассивКомплектующих);

	Если Запрос.Выполнить().Выбрать().Следующий() Тогда
    	Сообщить("Недостаточно комплектующих на складе. Проведение отменено.");
    	Отказ = Истина;
    	Возврат;
	КонецЕсли;

КонецПроцедуры
