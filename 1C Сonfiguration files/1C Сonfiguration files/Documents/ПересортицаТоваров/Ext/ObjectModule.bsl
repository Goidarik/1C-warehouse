
Процедура ОбработкаПроведения(Отказ, Режим)
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
    Сообщить("Не заполнен склад.");
    Отказ = Истина;
    Возврат;
	КонецЕсли;

	// Проверка строк "Списать" и сбор массива для контроля минусов
	МассивСписать = Новый Массив;

	Для каждого СтрСписать Из Списать Цикл
    	Если Не ЗначениеЗаполнено(СтрСписать.Товар) Тогда
        	Сообщить("Не заполнен товар в табличной части Списать.");
        	Отказ = Истина;
        	Продолжить;
    	КонецЕсли;

    	Если СтрСписать.Количество <= 0 Тогда
        	Сообщить("Количество в табличной части Списать должно быть больше 0.");
        	Отказ = Истина;
        	Продолжить;
    	КонецЕсли;

    	МассивСписать.Добавить(СтрСписать.Товар);
	КонецЦикла;

	// Проверка строк "Оприходовать"
	Для каждого СтрОпр Из Оприходовать Цикл
    	Если Не ЗначениеЗаполнено(СтрОпр.Товар) Тогда
        	Сообщить("Не заполнен товар в табличной части Оприходовать.");
        	Отказ = Истина;
        	Продолжить;
    	КонецЕсли;

    	Если СтрОпр.Количество <= 0 Тогда
        	Сообщить("Количество в табличной части Оприходовать должно быть больше 0.");
        	Отказ = Истина;
        	Продолжить;
    	КонецЕсли;
	КонецЦикла;

	Если Отказ Тогда
    	Возврат;
	КонецЕсли;


	// регистр ОстаткиТоваровНаСкладах Расход
	Движения.ОстаткиТоваровНаСкладах.Очистить();
	Движения.ОстаткиТоваровНаСкладах.Записывать = Истина;
	Для Каждого ТекСтрокаСписать Из Списать Цикл
		Движение = Движения.ОстаткиТоваровНаСкладах.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = ТекСтрокаСписать.Товар;
		Движение.Склад = Склад;
		Движение.Количество = ТекСтрокаСписать.Количество;
	КонецЦикла;

	// регистр ОстаткиТоваровНаСкладах Приход
	Движения.ОстаткиТоваровНаСкладах.Записывать = Истина;
	Для Каждого ТекСтрокаОприходовать Из Оприходовать Цикл
		Движение = Движения.ОстаткиТоваровНаСкладах.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Товар = ТекСтрокаОприходовать.Товар;
		Движение.Склад = Склад;
		Движение.Количество = ТекСтрокаОприходовать.Количество;
	КонецЦикла;
	
	// При отрицательных остатках на складе
	Попытка
    	Движения.Записать();
	Исключение
    	ТекстОшибки = ОписаниеОшибки();

    	Сообщ = Новый СообщениеПользователю;
    	Сообщ.Текст =
        	"Недостаточно товара на складе (или движение не может быть записано). Проведение отменено."
        	+ Символы.ПС + Символы.ПС
        	+ "Технические подробности:" + Символы.ПС + ТекстОшибки;
    	Сообщ.Сообщить();

    	Отказ = Истина;
    	Возврат;
	КонецПопытки;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|   Остатки.Товар,
	|   Остатки.Склад,
	|   Остатки.КоличествоОстаток
	|ИЗ
	|   РегистрНакопления.ОстаткиТоваровНаСкладах.Остатки(&Момент) КАК Остатки
	|ГДЕ
	|   Остатки.КоличествоОстаток < 0
	|   И Остатки.Склад = &Склад
	|   И Остатки.Товар В (&МассивТоваров)";

	Запрос.УстановитьПараметр("Момент", Новый Граница(Дата, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("МассивТоваров", МассивСписать);

	Если Запрос.Выполнить().Выбрать().Следующий() Тогда
	    Сообщить("Недостаточно товара для пересортицы (табличная часть Списать). Проведение отменено.");
	    Отказ = Истина;
	    Возврат;
	КонецЕсли;

	//}}__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
КонецПроцедуры

