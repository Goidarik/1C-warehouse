Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// 1) Проверка шапки
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Сообщить("Не заполнен склад.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// 2) Подготовка движений
	Движения.ОстаткиТоваровНаСкладах.Очистить();
	Движения.ОстаткиТоваровНаСкладах.Записывать = Истина;

	// Список товаров документа — нужен для проверки отрицательных остатков
	МассивТоваров = Новый Массив;

	// 3) Формируем движения: расход материалов со склада
	Для Каждого ТекСтрока Из Материалы Цикл

		Если Не ЗначениеЗаполнено(ТекСтрока.Товар) Тогда
			Сообщить("Не заполнен товар в табличной части.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		Если ТекСтрока.Количество <= 0 Тогда
			Сообщить("Количество должно быть больше 0.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		МассивТоваров.Добавить(ТекСтрока.Товар);

		Движение = Движения.ОстаткиТоваровНаСкладах.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Склад = Склад;
		Движение.Товар = ТекСтрока.Товар;
		Движение.Количество = ТекСтрока.Количество;

	КонецЦикла;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// Проверяем, не ушли ли остатки в минус
	
	// Записываем движения, затем проверяем минусы
	// При отрицательных остатках на складе
	Попытка
    	Движения.Записать();
	Исключение
    	ТекстОшибки = ОписаниеОшибки();

    	Сообщ = Новый СообщениеПользователю;
    	Сообщ.Текст =
        	"Недостаточно товара на складе (или движение не может быть записано). Проведение отменено."
        	+ Символы.ПС + Символы.ПС
        	+ "Технические подробности:" + Символы.ПС + ТекстОшибки;
    	Сообщ.Сообщить();

    	Отказ = Истина;
    	Возврат;
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Товар,
	|	Остатки.Склад,
	|	Остатки.КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровНаСкладах.Остатки(&Момент) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0
	|	И Остатки.Склад = &Склад
	|	И Остатки.Товар В (&МассивТоваров)";
	
	Запрос.УстановитьПараметр("Момент", Новый Граница(Дата, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("МассивТоваров", МассивТоваров);

	Если Запрос.Выполнить().Выбрать().Следующий() Тогда
		Сообщить("Недостаточно материалов на складе. Проведение отменено.");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры
