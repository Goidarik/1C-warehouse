Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

    Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление") Тогда

        // шапка
        Склад = ДанныеЗаполнения.Склад;

        // табличная часть
        Товары.Очистить();
        Для каждого Стр Из ДанныеЗаполнения.Товары Цикл
            Нов = Товары.Добавить();
            Нов.Товар = Стр.Товар;
            Нов.Количество = Стр.Количество;
        КонецЦикла;

    КонецЕсли;

КонецПроцедуры


Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Сообщить("Не заполнен склад.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Движения.ОстаткиТоваровНаСкладах.Очистить();
	Движения.ОстаткиТоваровНаСкладах.Записывать = Истина;

	МассивТоваров = Новый Массив;

	Для Каждого СтрокаТовары Из Товары Цикл

		Если Не ЗначениеЗаполнено(СтрокаТовары.Товар) Тогда
			Сообщить("Не заполнен товар в табличной части.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		Если СтрокаТовары.Количество <= 0 Тогда
			Сообщить("Количество должно быть больше 0.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		МассивТоваров.Добавить(СтрокаТовары.Товар);

		Движение = Движения.ОстаткиТоваровНаСкладах.Добавить();
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Склад = Склад;
		Движение.Товар = СтрокаТовары.Товар;
		Движение.Количество = СтрокаТовары.Количество;

	КонецЦикла;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;


	// Ищем отрицательные остатки (ограничим складом и товарами документа)
	// Записываем движения, затем проверяем минусы
	// При отрицательных остатках на складе
	Попытка
    	Движения.Записать();
	Исключение
    	ТекстОшибки = ОписаниеОшибки();

    	Сообщ = Новый СообщениеПользователю;
    	Сообщ.Текст =
        	"Недостаточно товара на складе (или движение не может быть записано). Проведение отменено."
        	+ Символы.ПС + Символы.ПС
        	+ "Технические подробности:" + Символы.ПС + ТекстОшибки;
    	Сообщ.Сообщить();

    	Отказ = Истина;
    	Возврат;
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Товар,
	|	Остатки.Склад,
	|	Остатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровНаСкладах.Остатки(&Момент) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0
	|	И Остатки.Склад = &Склад
	|	И Остатки.Товар В (&МассивТоваров)";
	
	Запрос.УстановитьПараметр("Момент", Новый Граница(Дата, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("МассивТоваров", МассивТоваров);

	Результат = Запрос.Выполнить().Выбрать();

	Если Результат.Следующий() Тогда
		Сообщить("Недостаточно товара на складе. Проведение отменено.");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры
