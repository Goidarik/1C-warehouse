
Процедура ОбработкаПроведения(Отказ, Режим)
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	// Простые проверки заполнения
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Сообщить("Не заполнен склад.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	    

	// Проверка строк и сбор списка товаров для контроля минусов
	МассивТоваров = Новый Массив;

	Для Каждого ТекСтрокаТовары Из Товары Цикл

		Если Не ЗначениеЗаполнено(ТекСтрокаТовары.Товар) Тогда
			Сообщить("Не заполнен товар в табличной части.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		Если ТекСтрокаТовары.Количество <= 0 Тогда
			Сообщить("Количество должно быть больше 0.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		МассивТоваров.Добавить(ТекСтрокаТовары.Товар);

	КонецЦикла;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// регистр ОстаткиТоваровНаСкладах Расход
	Движения.ОстаткиТоваровНаСкладах.Очистить();
	Движения.ОстаткиТоваровНаСкладах.Записывать = Истина;
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		Движение = Движения.ОстаткиТоваровНаСкладах.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = ТекСтрокаТовары.Товар;
		Движение.Склад = Склад;
		Движение.Количество = ТекСтрокаТовары.Количество;
	КонецЦикла;

	// Записываем движения, затем проверяем, не ушли ли в минус
	// При отрицательных остатках на складе
	Попытка
    	Движения.Записать();
	Исключение
    	ТекстОшибки = ОписаниеОшибки();

    	Сообщ = Новый СообщениеПользователю;
    	Сообщ.Текст =
        	"Недостаточно товара на складе (или движение не может быть записано). Проведение отменено."
        	+ Символы.ПС + Символы.ПС
        	+ "Технические подробности:" + Символы.ПС + ТекстОшибки;
    	Сообщ.Сообщить();

    	Отказ = Истина;
    	Возврат;
	КонецПопытки;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Товар,
	|	Остатки.Склад,
	|	Остатки.КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровНаСкладах.Остатки(&Момент) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0
	|	И Остатки.Склад = &Склад
	|	И Остатки.Товар В (&МассивТоваров)";
	
	Запрос.УстановитьПараметр("Момент", Новый Граница(Дата, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("МассивТоваров", МассивТоваров);

	Если Запрос.Выполнить().Выбрать().Следующий() Тогда
		Сообщить("Недостаточно товара на складе. Проведение отменено.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;


	//}}__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
КонецПроцедуры

