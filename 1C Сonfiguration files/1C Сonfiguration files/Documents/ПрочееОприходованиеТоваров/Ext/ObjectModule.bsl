Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Сообщить("Не заполнен склад.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Движения.ОстаткиТоваровНаСкладах.Очистить();
	Движения.ОстаткиТоваровНаСкладах.Записывать = Истина;

	Для Каждого СтрокаТовары Из Товары Цикл

		Если Не ЗначениеЗаполнено(СтрокаТовары.Товар) Тогда
			Сообщить("Не заполнен товар в табличной части.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		Если СтрокаТовары.Количество <= 0 Тогда
			Сообщить("Количество должно быть больше 0.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		Движение = Движения.ОстаткиТоваровНаСкладах.Добавить();
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Склад = Склад;
		Движение.Товар = СтрокаТовары.Товар;
		Движение.Количество = СтрокаТовары.Количество;

	КонецЦикла;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры
